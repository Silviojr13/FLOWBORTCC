// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  // Note: The URL is provided via the adapter in lib/turso-db.ts
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for credentials authentication
  provider      String?
  providerId    String?
  // Respostas opcionais do onboarding. Nulas quando a pergunta foi pulada.
  profile               String?
  discoverySource       String?
  // Nulo só em contas criadas depois desta coluna que ainda não concluíram
  // o onboarding. A migração preenche as contas anteriores com createdAt.
  onboardingCompletedAt DateTime?
  // Tour guiado da primeira sessão: nulo enquanto o usuário não concluiu nem pulou.
  tourCompletedAt       DateTime?
  // "user" | "admin": o admin cria e acompanha as avaliações de usabilidade
  role                  String    @default("user")
  // Tutoriais por página já concluídos: JSON { [chave]: data ISO }
  tutorialProgress      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  chats         Chat[]
  sessions      Session[]
  projects      Project[]
  studiesCreated      Study[]            @relation("StudiesCreated")
  studyParticipations StudyParticipant[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Conversa com o assistente de IA. `projectId` liga a conversa ao projeto que nasceu dela
// (Modo A) ou a uma conversa aberta de dentro do projeto pelo assistente flutuante.
model Chat {
  id        String    @id @default(cuid())
  title     String
  userId    String
  projectId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId])
  @@index([projectId])
  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  // "manual" | "ia" — de onde o projeto veio (define, por exemplo, se a vitrine de
  // componentes gera sugestões automaticamente ou só quando o usuário pedir)
  origin      String    @default("manual")
  // Projeto de exemplo criado automaticamente para o tour guiado da primeira sessão.
  isTutorial  Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  features     Feature[]
  tasks        Task[]
  components   HardwareComponent[]
  resources    Resource[]
  columns      KanbanColumn[]
  sprints      Sprint[]
  chats        Chat[]
  diagrams     Diagram[]

  @@map("projects")
}

// Status possíveis: "Em Aberto" | "Validado" | "Descartado" (RF01)
// Categoria: "Funcional" | "Não Funcional"
// Nível: "Sistema" | "Subsistema" | "Componente" (RF04)
model Requirement {
  id          String   @id @default(cuid())
  code        String
  description String
  category    String
  priority    String
  status      String   @default("Em Aberto")
  level       String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history    RequirementHistory[]
  features   Feature[]
  tasks      Task[]
  components HardwareComponent[]
  resources  Resource[]

  @@unique([projectId, code])
  @@map("requirements")
}

// Status possíveis: "Planejada" | "Em desenvolvimento" | "Concluída"
// Funcionalidade concreta derivada de um ou mais requisitos — etapa de planejamento,
// diferente das tarefas do Kanban (Task), que só entram em jogo na execução do projeto.
model Feature {
  id            String   @id @default(cuid())
  name          String
  description   String?
  status        String   @default("Planejada")
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@map("features")
}

// Snapshot do requisito no momento da alteração, para satisfazer RF03/RNF04 (versionamento)
model RequirementHistory {
  id            String   @id @default(cuid())
  requirementId String
  description   String
  category      String
  priority      String
  status        String
  level         String?
  changedAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("requirement_history")
}

// Coluna do quadro Kanban (RF05). Cada projeto tem suas próprias colunas, configuráveis
// pelo usuário; as padrão são Backlog | Em Progresso | Em Revisão | Concluído.
// `isDone` marca as colunas que contam como "tarefa concluída" para progresso/relatórios.
// `wipLimit` é o limite de trabalho em progresso da coluna (opcional, prática central do Kanban).
model KanbanColumn {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  isDone    Boolean  @default(false)
  wipLimit  Int?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("kanban_columns")
}

// Sprint (RF08): período de tempo ao qual um conjunto de tarefas é associado (UC07).
model Sprint {
  id        String   @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("sprints")
}

// Tarefa do Kanban (RF06): título, descrição, responsável, prazo, prioridade e vínculo
// a um requisito (rastreabilidade, RF02). A coluna em que está representa seu status.
// Prioridade: "Alta" | "Média" | "Baixa"
model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  priority      String    @default("Média")
  assignee      String?
  dueDate       DateTime?
  order         Int       @default(0)
  columnId      String
  projectId     String
  requirementId String?
  featureId     String?
  sprintId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  column      KanbanColumn  @relation(fields: [columnId], references: [id], onDelete: Restrict)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement?  @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  feature     Feature?      @relation(fields: [featureId], references: [id], onDelete: SetNull)
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  history     TaskHistory[]

  @@map("tasks")
}

// Histórico de movimentação da tarefa entre colunas (RF09). Guarda o nome das colunas
// (snapshot) para o registro sobreviver a renomeações/exclusões de coluna.
model TaskHistory {
  id         String   @id @default(cuid())
  taskId     String
  fromColumn String?
  toColumn   String
  changedAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_history")
}

model HardwareComponent {
  id            String   @id @default(cuid())
  name          String
  description   String?
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  // "Hardware" | "Software": o que vai no produto, físico ou não (placa, sensor, licença, biblioteca paga)
  domain        String   @default("Hardware")
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("hardware_components")
}

// Diagramas de engenharia de software do projeto (C4, ER, UML...), guardados como código
// Mermaid: o texto é a fonte da verdade e o desenho é gerado na tela.
model Diagram {
  id        String   @id @default(cuid())
  title     String
  // Chave do tipo em lib/diagrams.ts (ex.: "c4-context", "er", "class")
  type      String
  code      String
  // Instruções dadas à IA (ex.: "detalhe o firmware"): reaproveitadas ao gerar de novo
  instructions String?
  // "ia" | "dados" | "manual" — quem produziu a versão atual
  source    String   @default("ia")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("diagrams")
}

// Recursos que a organização usa para construir o projeto — pessoas, equipamentos,
// software e serviços, espaços. Diferente dos componentes, não vão dentro do produto e
// continuam com a organização depois. Cada um tem um custo de uso ou de aquisição.
model Resource {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // Chave em lib/resources.ts: "pessoa" | "equipamento" | "software" | "espaco" | "outro"
  type          String
  // "disponivel" (a organização já tem) | "adquirir" (precisa contratar ou comprar)
  availability  String   @default("disponivel")
  // "hora" | "mes" | "unico" — define o que a quantidade significa
  costModel     String   @default("unico")
  unitCost      Float    @default(0)
  quantity      Float    @default(1)
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("resources")
}

// Avaliação de usabilidade conduzida dentro da plataforma (validação do TCC). O roteiro de
// tarefas é fixo (lib/study.ts); o admin define textos, período e status.
model Study {
  id          String    @id @default(cuid())
  title       String
  intro       String
  privacy     String
  contact     String?
  // Código do link de convite: /avaliacao/<inviteCode>
  inviteCode  String    @unique
  // "aberta" | "encerrada"
  status      String    @default("aberta")
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy    User               @relation("StudiesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  participants StudyParticipant[]

  @@map("studies")
}

model StudyParticipant {
  id          String    @id @default(cuid())
  studyId     String
  userId      String
  // Aceite do termo de participação; também marca o início da contagem de tempo
  consentAt   DateTime  @default(now())
  submittedAt DateTime?
  // JSON: { sus: number[10], open: Record<string,string>, profile: Record<string,string> }
  answers     String?
  susScore    Float?

  study Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTaskProgress[]

  @@unique([studyId, userId])
  @@map("study_participants")
}

model StudyTaskProgress {
  id            String   @id @default(cuid())
  participantId String
  taskKey       String
  // "auto" (detectada pelo sistema) | "manual" (marcada pelo participante)
  method        String
  completedAt   DateTime @default(now())

  participant StudyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, taskKey])
  @@map("study_task_progress")
}
