// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  // Note: The URL is provided via the adapter in lib/turso-db.ts
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for credentials authentication
  provider      String?
  providerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  chats         Chat[]
  sessions      Session[]
  projects      Project[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Chat {
  id        String    @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  // "manual" | "ia" — de onde o projeto veio (define, por exemplo, se a vitrine de
  // componentes gera sugestões automaticamente ou só quando o usuário pedir)
  origin      String    @default("manual")
  startDate   DateTime?
  endDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  features     Feature[]
  tasks        Task[]
  components   HardwareComponent[]
  columns      KanbanColumn[]
  sprints      Sprint[]

  @@map("projects")
}

// Status possíveis: "Em Aberto" | "Validado" | "Descartado" (RF01)
// Categoria: "Funcional" | "Não Funcional"
// Nível: "Sistema" | "Subsistema" | "Componente" (RF04)
model Requirement {
  id          String   @id @default(cuid())
  code        String
  description String
  category    String
  priority    String
  status      String   @default("Em Aberto")
  level       String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history    RequirementHistory[]
  features   Feature[]
  tasks      Task[]
  components HardwareComponent[]

  @@unique([projectId, code])
  @@map("requirements")
}

// Status possíveis: "Planejada" | "Em desenvolvimento" | "Concluída"
// Funcionalidade concreta derivada de um ou mais requisitos — etapa de planejamento,
// diferente das tarefas do Kanban (Task), que só entram em jogo na execução do projeto.
model Feature {
  id            String   @id @default(cuid())
  name          String
  description   String?
  status        String   @default("Planejada")
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@map("features")
}

// Snapshot do requisito no momento da alteração, para satisfazer RF03/RNF04 (versionamento)
model RequirementHistory {
  id            String   @id @default(cuid())
  requirementId String
  description   String
  category      String
  priority      String
  status        String
  level         String?
  changedAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("requirement_history")
}

// Coluna do quadro Kanban (RF05). Cada projeto tem suas próprias colunas, configuráveis
// pelo usuário; as padrão são Backlog | Em Progresso | Em Revisão | Concluído.
// `isDone` marca as colunas que contam como "tarefa concluída" para progresso/relatórios.
// `wipLimit` é o limite de trabalho em progresso da coluna (opcional, prática central do Kanban).
model KanbanColumn {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  isDone    Boolean  @default(false)
  wipLimit  Int?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("kanban_columns")
}

// Sprint (RF08): período de tempo ao qual um conjunto de tarefas é associado (UC07).
model Sprint {
  id        String   @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("sprints")
}

// Tarefa do Kanban (RF06): título, descrição, responsável, prazo, prioridade e vínculo
// a um requisito (rastreabilidade, RF02). A coluna em que está representa seu status.
// Prioridade: "Alta" | "Média" | "Baixa"
model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  priority      String    @default("Média")
  assignee      String?
  dueDate       DateTime?
  order         Int       @default(0)
  columnId      String
  projectId     String
  requirementId String?
  featureId     String?
  sprintId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  column      KanbanColumn  @relation(fields: [columnId], references: [id], onDelete: Restrict)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement?  @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  feature     Feature?      @relation(fields: [featureId], references: [id], onDelete: SetNull)
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  history     TaskHistory[]

  @@map("tasks")
}

// Histórico de movimentação da tarefa entre colunas (RF09). Guarda o nome das colunas
// (snapshot) para o registro sobreviver a renomeações/exclusões de coluna.
model TaskHistory {
  id         String   @id @default(cuid())
  taskId     String
  fromColumn String?
  toColumn   String
  changedAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_history")
}

model HardwareComponent {
  id            String   @id @default(cuid())
  name          String
  description   String?
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("hardware_components")
}