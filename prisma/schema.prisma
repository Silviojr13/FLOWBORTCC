// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  // Note: The URL is provided via the adapter in lib/turso-db.ts
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for credentials authentication
  provider      String?
  providerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  chats         Chat[]
  sessions      Session[]
  projects      Project[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Chat {
  id        String    @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  // "manual" | "ia" — de onde o projeto veio (define, por exemplo, se a vitrine de
  // componentes gera sugestões automaticamente ou só quando o usuário pedir)
  origin      String    @default("manual")
  startDate   DateTime?
  endDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  features     Feature[]
  tasks        Task[]
  components   HardwareComponent[]

  @@map("projects")
}

// Status possíveis: "Em Aberto" | "Validado" | "Descartado" (RF01)
// Categoria: "Funcional" | "Não Funcional"
// Nível: "Sistema" | "Subsistema" | "Componente" (RF04)
model Requirement {
  id          String   @id @default(cuid())
  code        String
  description String
  category    String
  priority    String
  status      String   @default("Em Aberto")
  level       String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history    RequirementHistory[]
  features   Feature[]
  tasks      Task[]
  components HardwareComponent[]

  @@unique([projectId, code])
  @@map("requirements")
}

// Status possíveis: "Planejada" | "Em desenvolvimento" | "Concluída"
// Funcionalidade concreta derivada de um ou mais requisitos — etapa de planejamento,
// diferente das tarefas do Kanban (Task), que só entram em jogo na execução do projeto.
model Feature {
  id            String   @id @default(cuid())
  name          String
  description   String?
  status        String   @default("Planejada")
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("features")
}

// Snapshot do requisito no momento da alteração, para satisfazer RF03/RNF04 (versionamento)
model RequirementHistory {
  id            String   @id @default(cuid())
  requirementId String
  description   String
  category      String
  priority      String
  status        String
  level         String?
  changedAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("requirement_history")
}

// Status possíveis (RF05): "Backlog" | "Em Progresso" | "Em Revisão" | "Concluído"
model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  status        String   @default("Backlog")
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model HardwareComponent {
  id            String   @id @default(cuid())
  name          String
  description   String?
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  projectId     String
  requirementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("hardware_components")
}