# Ambiente de DESENVOLVIMENTO do FlowBot.
#   cp .env.example .env
#   npm run dev:setup
#   npm run dev
# Nunca coloque aqui as chaves de produção: elas ficam só na Vercel.

# Banco local (SQLite). O npm run dev:setup cria as tabelas e uma conta de teste.
DATABASE_URL="file:./dev.db"
# Só para o Turso; em desenvolvimento fica vazio.
TURSO_AUTH_TOKEN=""

# Segredo do login, só seu. Gere com: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# IA gratuita do FlowBot: crie sua chave em https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL_NAME="qwen/qwen3.8-27b"

# Opcionais
# Segredo das chaves de "Minhas IAs" (sem ele, usa o AUTH_SECRET).
AI_KEYS_SECRET=""
# Login com Google: crie um cliente OAuth próprio, com http://localhost:3000 como origem.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# E-mail de recuperação de senha; sem SMTP, o link aparece no terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
